# Copiez ce fichier en `.env` à la racine du projet (à côté de docker-compose.prod.yml). Ne le commitez jamais.

# --- Obligatoire ---
# Nom de domaine public (sans https://), dont le DNS pointe vers le serveur. Ex. : app.humaniq.tn
DOMAIN=
# Générez chaque secret : openssl rand -base64 48
POSTGRES_PASSWORD=
JWT_SECRET=
# 16 caractères minimum
MEILI_MASTER_KEY=

# --- E-mails (au choix : SMTP de votre boîte pro, ou Resend) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
# Ex. : HumanIQ <contact@votre-domaine.com>
MAIL_FROM=

# --- Intelligence artificielle (facultatif) ---
# Sans clé : modèle local et gabarits.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_EMBEDDING_MODEL=
AI_LLM_MODEL=
AI_LLM_PROVIDER=

# --- Extension Chrome (facultatif) ---
# Origine de l'extension une fois publiée, ex. chrome-extension://abcdefghijklmnopabcdefghijklmnop (séparées par des virgules)
EXTENSION_ORIGINS=
