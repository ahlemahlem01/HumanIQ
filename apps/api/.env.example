# Copiez ce fichier en `.env` (jamais commité) et remplissez les valeurs.

DATABASE_URL=postgresql://utilisateur:motdepasse@localhost:5432/humaniq
# En production : valeur longue et aléatoire, obligatoire (ex. `openssl rand -base64 48`).
JWT_SECRET=
JWT_EXPIRES_IN=7d
PORT=4100
FRONTEND_URL=http://localhost:3100

# --- Recherche (Meilisearch) ---
MEILI_HOST=http://localhost:7700
MEILI_KEY=

# --- Couche IA ---
# Sans clé : embeddings via modèle local déterministe + feedback par gabarit.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_EMBEDDING_MODEL=
AI_LLM_MODEL=
AI_LLM_PROVIDER=

# --- E-mails ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
MAIL_FROM=

# --- Données de démonstration (scripts `npm run seed` et `seed:demo`) ---
# Mot de passe des comptes fictifs (défaut local : Demo1234!). Obligatoire si NODE_ENV=production.
SEED_DEMO_PASSWORD=
# Mot de passe du compte ESPRIT ; s'il est vide, le seed en génère un et l'affiche une seule fois.
# Utilisé aussi par les tests d'intégration (`npm test`).
ESPRIT_PASSWORD=
