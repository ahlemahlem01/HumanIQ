# Copiez ce fichier en `.env` (jamais commité) et remplissez les valeurs.

DATABASE_URL=postgresql://utilisateur:motdepasse@localhost:5432/humaniq
# En production : valeur longue et aléatoire, obligatoire (ex. `openssl rand -base64 48`).
JWT_SECRET=
JWT_EXPIRES_IN=7d
PORT=4100
FRONTEND_URL=http://localhost:3100

# --- Recherche (Meilisearch) ---
MEILI_HOST=http://localhost:7700
MEILI_KEY=

# --- Couche IA ---
# Sans clé : embeddings via modèle local déterministe + feedback par gabarit.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_EMBEDDING_MODEL=
AI_LLM_MODEL=
AI_LLM_PROVIDER=

# --- E-mails ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
MAIL_FROM=

# --- Données de démonstration (scripts `npm run seed` et `seed:demo`) ---
# Mot de passe des comptes fictifs (défaut local : Demo1234!). Obligatoire si NODE_ENV=production.
SEED_DEMO_PASSWORD=
# Mot de passe du compte ESPRIT ; s'il est vide, le seed en génère un et l'affiche une seule fois.
# Utilisé aussi par les tests d'intégration (`npm test`).
ESPRIT_PASSWORD=

# --- Production (voir DEPLOY.md) ---
# NODE_ENV=production active : CORS limité à FRONTEND_URL, limitation de requêtes, JWT_SECRET obligatoire,
# et aucun lien secret renvoyé dans les réponses quand un e-mail ne part pas.
NODE_ENV=
# Identifiants d'extensions Chrome acceptées (chrome-extension://<id>), séparés par des virgules. En développement, toutes passent.
EXTENSION_ORIGINS=
# Nombre de reverse proxies devant l'API (1 avec Caddy/nginx). Sert à lire la vraie IP du client.
TRUST_PROXY=
# Active la limitation de requêtes hors production (utile pour la tester).
THROTTLE_ENABLED=

# Dev only: accept personal mailboxes (Gmail...) for recruiter accounts. Leave unset in production.
# ALLOW_FREE_EMAIL_RECRUITERS=true
